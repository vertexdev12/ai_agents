# ---------- Telegram botlar ----------
# Har bir agent uchun alohida bot (BotFather'dan). Tokeni bo'lmagan agent asosiy bot orqali sarlavha bilan gapiradi,
# shuning uchun faqat MASTERMIND_BOT_TOKEN bilan boshlab, keyin qolganlarini qo'shsangiz bo'ladi.
MASTERMIND_BOT_TOKEN=
TUTOR_BOT_TOKEN=
CODE_BOT_TOKEN=
TIMECOP_BOT_TOKEN=
JOKER_BOT_TOKEN=
SECURITY_BOT_TOKEN=
# Bitta bot rejimi uchun eski nom (MASTERMIND_BOT_TOKEN o'rniga):
BOT_TOKEN=

# Kimlar foydalana oladi (Telegram ID, vergul bilan). Bo'sh bo'lsa, bot shaxsiy chatda ID'ingizni ko'rsatadi.
ALLOWED_USER_IDS=
# Ixtiyoriy: faqat shu guruhlarda ishlaydi (guruhda /myid yozsangiz, Chat ID chiqadi)
ALLOWED_CHAT_IDS=

# ---------- LLM ----------
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Umumiy (zaxira) kalit: alohida kaliti yo'q agentlar shuni ishlatadi
GEMINI_API_KEY=
# Har bir agent uchun alohida kalit (ixtiyoriy). MUHIM: Gemini limiti KALIT bo'yicha emas, LOYIHA (Google Cloud
# project) bo'yicha hisoblanadi — kalitlar turli loyihalardan bo'lishi kerak.
MASTERMIND_API_KEY=
TUTOR_API_KEY=
CODE_API_KEY=
TIMECOP_API_KEY=
JOKER_API_KEY=
SECURITY_API_KEY=
# OpenAI ishlatmoqchi bo'lsangiz:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Ma'lumotlar bazasi ----------
# SQLite (standart) yoki Railway Postgres: ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite+aiosqlite:///./data/parliament.db

# ---------- Sozlamalar ----------
TIMEZONE=Asia/Tashkent
COP_AFTER_MINUTES=25
COP_MIN_MESSAGES=10
COP_DEADLINE_MINUTES=10
DAILY_MESSAGE_LIMIT=200
